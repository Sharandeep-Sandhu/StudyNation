# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration
# SQLite (development) — leave DATABASE_URL unset
# DATABASE_ENGINE=django.db.backends.sqlite3

# PostgreSQL via URL (Render sets this automatically)
# DATABASE_URL=postgresql://user:password@localhost:5432/learning_hub
# DATABASE_SSL_REQUIRE=False

# Or discrete Postgres vars (Docker Compose)
# DATABASE_ENGINE=django.db.backends.postgresql
# DATABASE_NAME=learning_hub
# DATABASE_USER=postgres
# DATABASE_PASSWORD=your-password
# DATABASE_HOST=localhost
# DATABASE_PORT=5432

# Security / CSRF (production HTTPS origins, comma-separated)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# CORS Settings
CORS_ALLOW_ALL_ORIGINS=True

# Logging
LOG_LEVEL=INFO

# Email Configuration (optional)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-password

# ========== SUPERUSER (Only for first deploy) ==========
CREATE_SUPERUSER=True
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=your-email@gmail.com
DJANGO_SUPERUSER_PASSWORD=Password@123